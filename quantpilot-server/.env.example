# QuantPilot 服务端配置示例
# 复制为 .env 并填写。所有变量以 QP_ 开头，被 app/core/config.py 读取。

# ===== LLM（统一接口，默认 DeepSeek）=====
# 供应商：deepseek | openai | qwen | custom（均为 OpenAI 兼容 /chat/completions）
QP_LLM_PROVIDER=deepseek
# 默认模型 deepseek-flash，可改为 deepseek-chat / deepseek-reasoner 等
QP_LLM_MODEL=deepseek-flash
# API Key：必填才能用真实 LLM；留空则自动降级为 OfflineProvider（离线演示）
QP_LLM_API_KEY=
# API 地址：默认 DeepSeek；换供应商时改这里（custom 供应商必须填）
QP_LLM_BASE_URL=https://api.deepseek.com/v1
# 请求超时（秒）
QP_REQUEST_TIMEOUT=120

# ===== 生成控制 =====
QP_SPEC_MAX_RETRIES=1
QP_CODE_MAX_RETRIES=1
QP_REPAIR_MAX_ROUNDS=2

# ===== 服务端 =====
# API 监听
QP_HOST=0.0.0.0
QP_PORT=8000
# 允许的跨域来源（H5 本地预览），逗号分隔；* 表示全部
QP_CORS_ORIGINS=*

# ===== 沙箱 runner =====
# podman=生产（需容器）| local=本机 python（需 qlib）| demo=离线演示（无需 qlib/容器，产出模拟结果）
QP_SANDBOX_RUNNER=demo

# ===== 沙箱 =====
QP_SANDBOX_IMAGE=localhost/quantpilot/sandbox:0.1
# 容器挂载源目录；Linux 用 /data/qlib，Windows 用原生路径 C:\...\sandbox\data\cn_data
QP_QLIB_PROVIDER_URI=/data/qlib
# 可选：podman.exe 绝对路径（PATH 未刷新时）
QP_PODMAN_BIN=

# ===== 存储 =====
# 数据平台（资产/血缘/质量报告/导入审核）与策略观察期（Track）账本持久化。
# 留空 = 内存目录 + JSON 文件（重启即丢）；填写 = PostgreSQL。
#
# 本地起库（podman，纯脚本无需 compose）：
#     ./scripts/pg.sh up        # 起库，默认 127.0.0.1:5432
#     ./scripts/pg.sh status    # 看健康状态与表数量
#     python -m app.db.cli init-db --seed
#
# 注意：Windows 上 podman 依赖 WSL 虚拟机，machine 没起来时一切 podman 命令
# 都会报退出码 125（连不上 socket），先 `podman machine start`。
QP_DATABASE_URL=
# 本地示例：
# QP_DATABASE_URL=postgresql+psycopg://quantpilot:quantpilot_dev@127.0.0.1:5432/quantpilot
QP_DB_ECHO=false
# CSV 导入大小上限（字节），默认 10MB
QP_IMPORT_MAX_BYTES=10485760
# QP_REDIS_URL=redis://localhost:6379/0
